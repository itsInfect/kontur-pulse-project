DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
FRONTEND_ORIGIN="http://127.0.0.1:5173"
AUTH_COOKIE_PATH="/api/auth"
# Required when the backend runs on more than one instance (for example, Vercel).
# REDIS_URL="rediss://default:password@host:6379"
PORT=3000
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER and SMTP_PASSWORD are optional for local Mailpit.
# SMTP_USER=""
# SMTP_PASSWORD=""
# Use RESEND_API_KEY instead of SMTP for HTTPS email delivery on cloud hosts.
# RESEND_API_KEY=""
MAIL_FROM="Kontur Pulse <no-reply@pulse.local>"
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_INTERNAL_URL="http://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="replace-with-livekit-secret"
